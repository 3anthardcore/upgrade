{
  "name": "upgrade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent, evidence-driven website migration to Bitrix",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "upgrade": "./packages/cli/index.ts"
  },
  "scripts": {
    "upgrade": "node --disable-warning=ExperimentalWarning packages/cli/index.ts",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test tests/e2e/*.test.ts",
    "test:agents": "node --disable-warning=ExperimentalWarning scripts/agent-smoke.ts",
    "fixture": "node tests/fixtures/sites/server.ts",
    "demo:fixture": "node --disable-warning=ExperimentalWarning scripts/fixture-demo.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
