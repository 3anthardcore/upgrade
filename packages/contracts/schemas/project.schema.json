{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source",
    "target",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source": {
      "type": "object",
      "required": ["entry_url", "allowed_hosts", "mode"],
      "properties": {
        "entry_url": {
          "type": "string"
        },
        "allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": ["public-demo", "owner-migration", "bitrix-redesign"]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["platform", "environment_profile"],
      "properties": {
        "platform": {
          "const": "bitrix"
        },
        "environment_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
