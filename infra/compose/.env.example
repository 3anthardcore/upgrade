# Supply actual tested immutable image digests; placeholders intentionally cannot start.
UPGRADE_PROJECT_ID=example-demo
UPGRADE_TARGET_ID=REPLACE_WITH_NEW_TARGET_UUID
UPGRADE_PHP_IMAGE=php:8.3-fpm-bookworm@sha256:REPLACE_AFTER_VALIDATION
UPGRADE_NGINX_IMAGE=nginx:stable@sha256:REPLACE_AFTER_VALIDATION
UPGRADE_MYSQL_IMAGE=mysql:8.0@sha256:REPLACE_AFTER_VALIDATION
UPGRADE_DOCUMENT_ROOT=/srv/upgrade/example-demo/site
UPGRADE_STATE_DIR=/srv/upgrade/example-demo/state
UPGRADE_HTTP_PORT=8090
UPGRADE_HTPASSWD_FILE=/srv/upgrade/example-demo/secrets/htpasswd
UPGRADE_DB_PASSWORD_FILE=/srv/upgrade/example-demo/secrets/db-password
UPGRADE_DB_ROOT_PASSWORD_FILE=/srv/upgrade/example-demo/secrets/db-root-password
